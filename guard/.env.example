# Testnet (chain 97) values below. For mainnet use CHAIN_ID=56, BSC_RPC=https://bsc-dataseed.bnbchain.org,
# IDENTITY_REGISTRY=0x8004A169FB4a3325136EB29fA0ceB6D2e539a432, YINKO_REGISTRY=0xdE93A1e641cD067Eb202dAF3666b1665b5915a44
BSC_RPC=https://data-seed-prebsc-1-s1.bnbchain.org:8545
CHAIN_ID=97
IDENTITY_REGISTRY=0x8004A818BFB912233c491871b3d84c89A494BD9e
YINKO_REGISTRY=0x760f6475de49bE4B1caac9849B9CE36421E1E7dA
# How far back to scan for history and approvals (public RPCs limit range per request)
HISTORY_BLOCKS=50000
CHUNK_BLOCKS=5000
# OPTIONAL, testnet only: a fresh throwaway key (cast wallet new) funded with ~0.02 tBNB.
# Enables writing attestations on-chain. Never put a real wallet key here.
GUARD_PRIVATE_KEY=

# Public API: on-chain recording only runs when the request carries this secret in the x-yinko-token header.
ATTEST_TOKEN=

# YinkoWatch contract address (reports and vouches from Agent ID holders). Leave empty until deployed.
WATCH_CONTRACT=
